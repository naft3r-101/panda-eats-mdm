<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pandaeats.bench.wallpaper" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 13+ needs this temporary app-op to SAVE the old wallpaper for rollback. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application android:label="Panda Bench wallpaper" android:allowBackup="false" android:hasCode="true">
        <provider android:name=".WallpaperProvider" android:authorities="com.pandaeats.bench.wallpaper"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
